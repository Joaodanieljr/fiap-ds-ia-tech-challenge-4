# Copie para .env e preencha localmente. Nunca versione o arquivo .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Contrato inicial da branch feat/base-conhecimento do Vini.
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=avaliacoes_olist

# O indice usa paraphrase-multilingual-MiniLM-L12-v2 com vetores normalizados.
# Parametro inicial; calibrar com a amostra antes de fechar a avaliacao.
RETRIEVAL_TOP_K=5
