# Copie para .env e preencha localmente. Nunca versione o arquivo .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Contrato inicial da branch feat/base-conhecimento.
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=avaliacoes_olist

# O indice usa paraphrase-multilingual-MiniLM-L12-v2 com vetores normalizados.
# Define o numero maximo de evidencias candidatas.
RETRIEVAL_TOP_K=5

# Limite exploratorio calibrado no indice completo: 0.408.
# Deixe vazio para a amostra de desenvolvimento ou para desativar a abstencao por distancia.
RETRIEVAL_MAX_DISTANCE=
